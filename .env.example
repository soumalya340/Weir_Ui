# Circle Developer Console → Keys → API key (server only — never expose to the browser)
CIRCLE_API_KEY=

# Circle Console → Wallets → User Controlled → Configurator → App ID
NEXT_PUBLIC_CIRCLE_APP_ID=

# Google Cloud OAuth Web Client ID (wired into Circle social login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional override (defaults to https://api.circle.com)
# NEXT_PUBLIC_CIRCLE_BASE_URL=https://api.circle.com
